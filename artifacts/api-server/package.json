{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm --filter @workspace/db run push && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/lib/attemptValidation.test.ts src/lib/confirmServiceRegression.test.ts src/lib/payoutStateMachine.test.ts src/lib/adminUserFilters.test.ts src/lib/mailer.test.ts src/lib/affidavitPipeline.test.ts src/lib/pickupNotificationEmail.test.ts src/lib/attemptNotificationEmail.test.ts src/lib/regenerateAffidavit.test.ts src/routes/draftJobsLifecycle.test.ts src/routes/adminMailerTest.test.ts src/routes/adminAuditDateRange.test.ts",
    "test:unit": "node --import tsx --test src/lib/attemptValidation.test.ts src/lib/confirmServiceRegression.test.ts src/lib/mailer.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.9",
    "@clerk/shared": "^4.8.5",
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-certn": "workspace:*",
    "@workspace/integrations-email": "workspace:*",
    "@workspace/integrations-sms": "workspace:*",
    "@workspace/pricing": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^3.0.5",
    "nanoid": "^5.1.9",
    "pdfkit": "^0.18.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pdf-parse": "1.1.1",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
